---
interface Props {
  size?: number;
  light?: boolean;
}
const { size = 30, light = false } = Astro.props;
---

<span class="logo" style={`--s:${size}px;--logo-ink:${light ? '#fff' : 'var(--ink)'}`} aria-label="MutuLab">
  <svg viewBox="0 0 40 40" width={size} height={size} aria-hidden="true">
    <defs>
      <linearGradient id="ml-g" x1="0" y1="0" x2="1" y2="1">
        <stop offset="0" stop-color="#4C8DFF" />
        <stop offset="1" stop-color="#1F5EFF" />
      </linearGradient>
    </defs>
    <rect x="1" y="1" width="38" height="38" rx="12" fill="url(#ml-g)" />
    <path d="M8 27.5 L15.5 15 L21 23 L26 12.5 L32 27.5 Z" fill="#fff" opacity=".96" />
    <path d="M8 27.5 L15.5 15 L18.2 19.7 L13.4 27.5 Z" fill="#CFE6FF" opacity=".9" />
    <circle cx="29.5" cy="12" r="2.4" fill="#7DB36A" />
  </svg>
  <span class="wordmark">Mutu<span class="lab">Lab</span></span>
</span>

<style>
  .logo { display: inline-flex; align-items: center; gap: .55rem; color: var(--logo-ink); }
  .wordmark { font-family: var(--font-ui); font-weight: 700; font-size: calc(var(--s) * .72); letter-spacing: -.035em; white-space: nowrap; }
  .lab { font-weight: 500; opacity: .78; }
</style>
