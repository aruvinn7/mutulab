---
import { MODULES } from '../../data/site';
import Icon from './Icon.astro';
---

<section class="section learning" id="peta-belajar" aria-labelledby="learning-title">
  <div class="container">
    <header class="section-head">
      <p class="eyebrow">Peta belajar</p>
      <h2 id="learning-title" class="serif">Enam langkah, satu <em>percaya diri.</em></h2>
      <p class="section-sub">Tiap modul memakai alur yang sama: kenapa penting → konsep inti → contoh dikerjakan → coba sendiri → latihan → ringkasan.</p>
    </header>

    <div class="bento module-bento">
      {MODULES.map((m) => (
        <a class:list={['card', 'module-card', 'span-4', { 'is-start': m.number === '1' }]}
          href={`/modul/${m.slug}/`}>
          <div class="module-top">
            <span class="module-no mono">{m.number.padStart(2, '0')}</span>
            <span class="module-icon"><Icon name={m.icon} size={20} /></span>
          </div>
          {m.number === '1' && <span class="start-badge">Mulai di sini</span>}
          <h3>{m.title}</h3>
          <p class="module-sub">{m.subtitle}</p>
          <div class="module-foot">
            <span class="module-time mono">± {m.minutes} menit</span>
            <span class="module-level">{m.difficulty}</span>
            <Icon name="arrow" size={15} />
          </div>
        </a>
      ))}
    </div>

    <p class="learning-foot">
      Ingin melihat semua modul sekaligus? <a href="/modul/">Buka indeks modul <span aria-hidden="true">→</span></a>
    </p>
  </div>
</section>

<style>
  /* Seksi transparan: foto lanskap tetap tampak di sela kartu modul. */
  .learning { background: transparent; }
  .section-head { position: relative; text-align: center; max-width: 820px; margin: 0 auto 3.2rem;
    padding: clamp(1.5rem, 3.2vw, 2.4rem) clamp(1.25rem, 3vw, 2.5rem);
    border-radius: var(--radius-card); border: 1px solid var(--glass-border);
    background: rgba(255,255,255,.86); backdrop-filter: blur(var(--glass-blur)) saturate(140%);
    -webkit-backdrop-filter: blur(var(--glass-blur)) saturate(140%); box-shadow: var(--glass-shadow); }
  .section-head .eyebrow { color: var(--accent); }
  .section-head h2 { font-size: var(--fs-h1); line-height: 1.06; letter-spacing: -.035em; margin-top: .9rem; }
  .section-head h2 em { font-style: italic; color: var(--accent); }
  .section-sub { margin: 1.1rem auto 0; color: var(--ink-soft); max-width: 64ch; font-size: var(--fs-small); line-height: 1.7; }

  .module-card { display: flex; flex-direction: column; align-items: flex-start; gap: .55rem;
    padding: 1.45rem 1.45rem 1.25rem; min-height: 224px; position: relative;
    background: rgba(255,255,255,.88); border-color: var(--glass-border);
    backdrop-filter: blur(14px) saturate(140%); -webkit-backdrop-filter: blur(14px) saturate(140%);
    transition: transform .18s ease, box-shadow .18s ease, border-color .18s ease; }
  .module-card:hover { transform: translateY(-4px); border-color: var(--accent-soft);
    box-shadow: 0 20px 44px rgba(16,42,110,.13); }
  .module-card.is-start { border-color: var(--accent); box-shadow: 0 0 0 3px rgba(47,107,255,.09), var(--surface-shadow); }
  .module-top { display: flex; align-items: center; justify-content: space-between; width: 100%; }
  .module-no { font-size: 1.55rem; font-weight: 500; line-height: 1; color: var(--accent); }
  .module-icon { display: grid; place-items: center; width: 38px; height: 38px; border-radius: 12px;
    color: var(--accent); background: var(--accent-soft); }
  .start-badge { position: absolute; top: 1.35rem; left: 3.9rem; font-size: .58rem; font-weight: 700;
    letter-spacing: .08em; text-transform: uppercase; color: #fff; background: var(--accent);
    padding: .22rem .55rem; border-radius: var(--radius-pill); }
  .module-card h3 { font-family: var(--font-display); font-weight: 400; font-size: 1.42rem;
    line-height: 1.15; letter-spacing: -.02em; }
  .module-sub { color: var(--ink-soft); font-size: .8rem; line-height: 1.5; flex: 1; }
  .module-foot { display: flex; align-items: center; gap: .6rem; width: 100%;
    padding-top: .8rem; margin-top: .2rem; border-top: 1px solid var(--surface-border);
    font-size: .68rem; color: var(--ink-soft); }
  .module-time { font-weight: 600; }
  .module-level { background: var(--surface-soft); border-radius: var(--radius-pill);
    padding: .2rem .55rem; font-weight: 600; color: var(--ink-soft); }
  .module-foot :global(svg) { margin-left: auto; color: var(--accent); }
  .learning-foot { display: flex; justify-content: center; align-items: center; gap: .6rem;
    text-align: center; margin-top: 2.4rem; font-size: var(--fs-small); color: var(--ink-soft); }
  .learning-foot a { display: inline-flex; padding: .45rem .9rem; border-radius: var(--radius-pill);
    background: var(--glass-bg-strong); border: 1px solid var(--glass-border);
    color: var(--ink); font-weight: 700; }
  .learning-foot a:hover { background: #fff; color: var(--accent); }
  .learning-foot a:hover { text-decoration: underline; }
  @media (max-width: 639px) {
    .module-card { min-height: 0; padding: 1.3rem; }
    .section-head { margin-bottom: 2.2rem; }
  }
  /* Mode Mengajar tetap solid & kontras tinggi tanpa foto/efek. */
  html[data-teaching='true'] .section-head,
  html[data-teaching='true'] .module-card { background: #fff; box-shadow: none; }
</style>
