---
/** Ikon SVG inline untuk kartu fitur & peta belajar. Tanpa dependensi baru. */
interface Props {
  name: string;
  size?: number;
  class?: string;
}
const { name, size = 22, class: className = '' } = Astro.props;
---

<span class:list={['icon', className]} aria-hidden="true">
  <svg viewBox="0 0 24 24" width={size} height={size} fill="none" stroke="currentColor"
    stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
    {name === 'compass' && <>
      <circle cx="12" cy="12" r="9" />
      <path d="m15.6 8.4-2.3 4.9-4.9 2.3 2.3-4.9 4.9-2.3Z" />
      <circle cx="12" cy="12" r="1" fill="currentColor" stroke="none" />
    </>}
    {name === 'chart' && <>
      <path d="M4 3.5v16.5h16" />
      <path d="m7 16.5 3.8-5.2 3 2.4L18.5 8" />
      <circle cx="10.8" cy="11.3" r="1.3" fill="currentColor" stroke="none" />
      <circle cx="18.5" cy="8" r="1.3" fill="currentColor" stroke="none" />
    </>}
    {name === 'layers' && <>
      <path d="m12 3 9 5-9 5-9-5 9-5Z" />
      <path d="m3 13 9 5 9-5" />
      <path d="m3 16.5 9 5 9-5" />
    </>}
    {name === 'grid' && <>
      <rect x="3.5" y="3.5" width="7" height="7" rx="1.6" />
      <rect x="13.5" y="3.5" width="7" height="7" rx="1.6" />
      <rect x="3.5" y="13.5" width="7" height="7" rx="1.6" />
      <rect x="13.5" y="13.5" width="7" height="7" rx="1.6" />
      <path d="M17 16.2h1.5M17.75 15.45v1.5" stroke-width="1.4" />
    </>}
    {name === 'target' && <>
      <circle cx="12" cy="12" r="9" />
      <circle cx="12" cy="12" r="5" />
      <circle cx="12" cy="12" r="1.6" fill="currentColor" stroke="none" />
    </>}
    {name === 'scan' && <>
      <path d="M4 8.5V6a2 2 0 0 1 2-2h2.5M15.5 4H18a2 2 0 0 1 2 2v2.5M20 15.5V18a2 2 0 0 1-2 2h-2.5M8.5 20H6a2 2 0 0 1-2-2v-2.5" />
      <path d="m8.5 14.5 2.5-3.2 2 2.1 2.6-4.2" />
    </>}
    {name === 'calculator' && <>
      <rect x="4" y="2.5" width="16" height="19" rx="2.5" />
      <rect x="7" y="5.5" width="10" height="3.6" rx="1" />
      <path d="M8.5 12.5h.01M12 12.5h.01M15.5 12.5h.01M8.5 16.5h.01M12 16.5h.01M15.5 16.5h.01" stroke-width="2.6" />
    </>}
    {name === 'sliders' && <>
      <path d="M5 3v18M12 3v18M19 3v18" />
      <rect x="3" y="6.5" width="4" height="4.2" rx="1.4" />
      <rect x="10" y="13.2" width="4" height="4.2" rx="1.4" />
      <rect x="17" y="8.5" width="4" height="4.2" rx="1.4" />
    </>}
    {name === 'projector' && <>
      <rect x="2.5" y="4.5" width="19" height="12.5" rx="2" />
      <path d="M8 21h8M12 17v4" />
      <circle cx="8.5" cy="10.8" r="2.4" />
      <path d="M14 9.2h4M14 12.8h4" />
    </>}
    {name === 'dice' && <>
      <rect x="3" y="3" width="18" height="18" rx="4" />
      <circle cx="8.5" cy="8.5" r="1.4" fill="currentColor" stroke="none" />
      <circle cx="15.5" cy="8.5" r="1.4" fill="currentColor" stroke="none" />
      <circle cx="12" cy="12" r="1.4" fill="currentColor" stroke="none" />
      <circle cx="8.5" cy="15.5" r="1.4" fill="currentColor" stroke="none" />
      <circle cx="15.5" cy="15.5" r="1.4" fill="currentColor" stroke="none" />
    </>}
    {name === 'offline' && <>
      <path d="M7.2 18.5H17a3.5 3.5 0 0 0 .4-6.98A5.5 5.5 0 0 0 6.9 10.1a4.2 4.2 0 0 0 .3 8.4Z" />
      <path d="m3.5 3.5 17 17" />
      <path d="M9 14.5h6" />
    </>}
    {name === 'arrow' && <>
      <path d="M4.5 12h14M13 6.5l6 5.5-6 5.5" />
    </>}
    {name === 'book' && <>
      <path d="M12 5.5c-2.2-1.7-5-2.2-8-1.5v13c3-.7 5.8-.2 8 1.5 2.2-1.7 5-2.2 8-1.5v-13c-3-.7-5.8-.2-8 1.5Z" />
      <path d="M12 5.5v13" />
    </>}
  </svg>
</span>

<style>
  .icon { display: inline-flex; align-items: center; justify-content: center; flex-shrink: 0; }
</style>
