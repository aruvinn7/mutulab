---
import Icon from './Icon.astro';

const features = [
  {
    icon: 'compass', span: 'span-6', feature: true,
    title: 'Fondasi yang kokoh',
    body: 'Mengapa OFAT gagal melihat interaksi, dan bagaimana replikasi, randomisasi, serta blocking menyelamatkan kesimpulanmu. Intuisi dulu — rumus kemudian.',
    href: '/modul/fondasi-berpikir-eksperimental/', link: 'Mulai dari fondasi',
  },
  {
    icon: 'calculator', span: 'span-3',
    title: 'Kalkulator bertahap',
    body: 'ANOVA, RCBD, Yates, S/N, dan kurva OC dengan substitusi angka yang transparan di setiap langkah.',
    href: '/kalkulator/', link: 'Buka kalkulator',
  },
  {
    icon: 'sliders', span: 'span-3',
    title: 'Simulator langsung',
    body: 'Geser variansi galat atau aktifkan interaksi, lalu amati perubahan keputusan uji.',
    href: '/simulator/', link: 'Coba simulator',
  },
  {
    icon: 'projector', span: 'span-4',
    title: 'Mode Mengajar',
    body: 'Tampilan proyektor jernih, preset studi kasus kelas, dan buka langkah hitung sesuai ritme kuliah.',
    href: '/panduan/', link: 'Lihat panduan',
  },
  {
    icon: 'dice', span: 'span-4',
    title: 'Latihan acak',
    body: 'Soal orisinal dengan angka berbeda tiap sesi dan umpan balik per langkah, bukan sekadar kunci jawaban.',
    href: '/latihan/', link: 'Buka latihan',
  },
  {
    icon: 'offline', span: 'span-4',
    title: 'Cangkang aplikasi (PWA)',
    body: 'Pasang cangkang aplikasi untuk membuka kembali modul dan kalkulator tanpa koneksi.',
    href: '/panduan/', link: 'Cara pemasangan',
  },
];
---

<section class="section features" id="fitur" aria-labelledby="features-title">
  <div class="container">
    <header class="section-head">
      <p class="eyebrow">Satu alur kerja, lengkap</p>
      <h2 id="features-title" class="serif">Satu platform, dari intuisi hingga <em>Taguchi.</em></h2>
      <p class="section-sub">Belajar sendiri atau mendemonstrasikannya di depan kelas — alat dan materinya sama.</p>
    </header>

    <div class="bento feature-bento">
      {features.map((f) => (
        <a class:list={['card', 'feature-card', f.span, { 'is-feature': f.feature }]} href={f.href}>
          <span class="feature-icon"><Icon name={f.icon} size={f.feature ? 26 : 22} /></span>
          <h3>{f.title}</h3>
          <p>{f.body}</p>
          <span class="feature-link">{f.link}<Icon name="arrow" size={15} /></span>
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  /* Seksi transparan: foto lanskap tetap tampak di celah antar kartu. */
  .features { background: transparent; }
  .section-head { position: relative; text-align: center; max-width: 820px; margin: 0 auto 3.2rem;
    padding: clamp(1.5rem, 3.2vw, 2.4rem) clamp(1.25rem, 3vw, 2.5rem);
    border-radius: var(--radius-card); border: 1px solid var(--glass-border);
    background: rgba(255,255,255,.86); backdrop-filter: blur(var(--glass-blur)) saturate(140%);
    -webkit-backdrop-filter: blur(var(--glass-blur)) saturate(140%); box-shadow: var(--glass-shadow); }
  .section-head .eyebrow { color: var(--accent); }
  .section-head h2 { font-size: var(--fs-h1); line-height: 1.06; letter-spacing: -.035em; margin-top: .9rem; }
  .section-head h2 em { font-style: italic; color: var(--accent); }
  .section-sub { margin: 1.1rem auto 0; color: var(--ink-soft); max-width: 62ch; font-size: var(--fs-small); line-height: 1.7; }

  .feature-card { display: flex; flex-direction: column; align-items: flex-start; gap: .65rem;
    padding: 1.5rem 1.5rem 1.35rem; min-height: 230px; text-decoration: none;
    background: rgba(255,255,255,.88); border-color: var(--glass-border);
    backdrop-filter: blur(14px) saturate(140%); -webkit-backdrop-filter: blur(14px) saturate(140%);
    transition: transform .18s ease, box-shadow .18s ease, border-color .18s ease; }
  .feature-card:hover { transform: translateY(-4px); border-color: var(--accent-soft);
    box-shadow: 0 20px 44px rgba(16,42,110,.13); }
  .feature-card.is-feature { background: linear-gradient(145deg, rgba(255,255,255,.95), rgba(255,255,255,.86) 65%); }
  .feature-icon { display: grid; place-items: center; width: 44px; height: 44px; border-radius: 14px;
    color: var(--accent); background: var(--accent-soft); }
  .is-feature .feature-icon { width: 50px; height: 50px; }
  .feature-card h3 { font-family: var(--font-display); font-weight: 400; font-size: 1.55rem; letter-spacing: -.02em; }
  .is-feature h3 { font-size: 1.9rem; }
  .feature-card p { color: var(--ink-soft); font-size: var(--fs-small); line-height: 1.65; flex: 1; }
  .feature-link { display: inline-flex; align-items: center; gap: .4rem; color: var(--accent);
    font-size: .78rem; font-weight: 600; }
  .feature-link :global(svg) { transition: transform .18s ease; }
  .feature-card:hover .feature-link :global(svg) { transform: translateX(3px); }

  @media (max-width: 639px) {
    .feature-card { min-height: 0; padding: 1.3rem; }
    .section-head { margin-bottom: 2.2rem; }
  }
  /* Mode Mengajar tetap solid & kontras tinggi tanpa foto/efek. */
  html[data-teaching='true'] .section-head,
  html[data-teaching='true'] .feature-card { background: #fff; box-shadow: none; border-color: var(--surface-border); }
</style>
