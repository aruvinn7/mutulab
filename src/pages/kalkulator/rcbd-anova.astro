---
import BaseLayout from '../../layouts/BaseLayout.astro';
import RcbdCalc from '../../components/calculators/RcbdCalc.tsx';
---

<BaseLayout
  title="RCBD · ANOVA Blok — MutuLab"
  description="Kalkulator RCBD bertahap: dekomposisi SS Treatment, SS Block, SS Error, serta perbandingan MS Error dengan dan tanpa pemblokan."
  wide
>
  <nav class="page-crumb glass-solid" aria-label="Breadcrumb">
    <a href="/kalkulator/">Kalkulator</a><span aria-hidden="true">/</span><span>RCBD ANOVA</span>
  </nav>
  <div class="calc-stage">
    <RcbdCalc client:load />
  </div>
</BaseLayout>

<style>
  .page-crumb { display: inline-flex; gap: .6rem; align-items: center; font-size: var(--fs-micro);
    color: var(--ink-soft); margin-bottom: 1rem; padding: .45rem .9rem; border-radius: var(--radius-pill); }
  .page-crumb a { font-weight: 700; color: var(--accent); }
  /* Kalkulator berdiri di atas permukaan kaca solid agar angka tetap terbaca. */
  .calc-stage :global(.calc-window) { background: var(--glass-bg-strong); }
</style>
