---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { MODULES, STAGES } from '../../data/site';
import ModuleCard from '../../components/module/ModuleCard.astro';

const filters = [
  { key: 'all', label: 'Semua modul' },
  { key: 'fondasi', label: 'Fondasi' },
  { key: 'doe', label: 'DOE' },
  { key: 'taguchi', label: 'Taguchi' },
  { key: 'sampling', label: 'Sampling' },
];
---

<BaseLayout
  title="Modul Pembelajaran — MutuLab"
  description="Jalur belajar berjenjang dari intuisi eksperimen hingga Taguchi dan Acceptance Sampling. Enam modul, masing-masing enam tahap pembelajaran."
  surface="page"
  wide
>
  <div class="modules-hero">
    <div class="hero-inner">
      <span class="hero-eyebrow">Jalur Belajar · 6 Modul</span>
      <h1 class="serif">Pahami eksperimen.<br /><em>Rancang kualitasnya.</em></h1>
      <p class="hero-lead">
        Mulai dari intuisi variasi dan fondasi Fisher, lalu naik ke ANOVA, blocking, faktorial 2<sup>k</sup>,
        dan robust design Taguchi. Setiap modul memakai enam tahap yang sama: kenapa, konsep, contoh,
        coba, latihan, dan ringkasan.
      </p>
      <div class="hero-actions">
        <a class="btn btn-primary" href={`/modul/${MODULES[1].slug}/`}>Mulai dari Modul 1 ↗</a>
        <a class="btn btn-ghost" href="/modul/pengantar-kualitas-sampling/">Mulai dari Sampling</a>
      </div>
    </div>

    <aside class="hero-journey glass-solid" aria-label="Ringkasan jalur belajar">
      <span class="journey-eyebrow eyebrow">Perjalananmu</span>
      <div class="journey-figure">
        <strong class="mono">06</strong>
        <span>modul berjenjang</span>
      </div>
      <ol class="journey-track">
        <li><span class="mono">01</span> Fondasi eksperimen</li>
        <li><span class="mono">02</span> ANOVA & blocking</li>
        <li><span class="mono">03</span> Faktorial 2ᵏ</li>
        <li><span class="mono">04</span> Taguchi & sampling</li>
      </ol>
      <div class="journey-foot">
        <span class="mono">36</span> tahap belajar · <span class="mono">~5 jam</span>
      </div>
    </aside>
  </div>

  <section class="modules-section" aria-labelledby="daftar-modul">
    <div class="section-head glass-solid">
      <div>
        <span class="eyebrow">Kurikulum</span>
        <h2 id="daftar-modul" class="serif">Satu jalur, dari nol hingga <em>Taguchi.</em></h2>
      </div>
      <div class="journey-summary glass-solid" data-hide-when-teaching>
        <span class="summary-number mono" data-total-done>0 / {MODULES.length}</span>
        <span class="summary-label">modul selesai</span>
      </div>
    </div>

    <div class="filter-bar glass-solid" role="group" aria-label="Filter jalur modul">
      {filters.map((f, i) => (
        <button
          type="button"
          class="filter-pill"
          data-filter={f.key}
          aria-pressed={i === 0 ? 'true' : 'false'}
          class:list={[{ active: i === 0 }]}
        >{f.label}</button>
      ))}
      <span class="filter-count text-soft" data-visible-count aria-live="polite"></span>
    </div>

    <div class="module-grid">
      {MODULES.map((module, i) => <ModuleCard module={module} index={i} />)}
    </div>

    <div class="cta-band glass-solid">
      <div>
        <span class="eyebrow">Lanjutkan</span>
        <h3 class="serif">Sudah paham konsepnya? <em>Uji kemampuanmu.</em></h3>
        <p class="text-soft">Bank soal acak dengan umpan balik per langkah, atau ringkasan rumus dalam satu halaman.</p>
      </div>
      <div class="cta-actions">
        <a class="btn btn-primary" href="/latihan/">Buka Latihan Soal</a>
        <a class="btn btn-ghost" href="/cheat-sheet/">Lihat Cheat Sheet</a>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  import { loadProgress } from '../../lib/storage';
  import { MODULES, STAGES } from '../../data/site';

  const progress = loadProgress();
  const totalStages = STAGES.length;
  let doneModules = 0;

  document.querySelectorAll<HTMLElement>('[data-module-card]').forEach((card) => {
    const slug = card.dataset.slug ?? '';
    const stages = progress.completedStages[slug] ?? [];
    const finished = progress.completedModules.includes(slug);
    if (finished) doneModules += 1;

    const status = card.querySelector<HTMLElement>('[data-status]');
    const fill = card.querySelector<HTMLElement>('[data-fill]');
    const pct = finished ? 100 : Math.min(100, (stages.length / totalStages) * 100);

    if (status) {
      status.textContent = finished
        ? 'Modul selesai ✓'
        : stages.length > 0
          ? `${stages.length} / ${totalStages} tahap selesai`
          : 'Belum dimulai';
      status.dataset.done = String(finished);
    }
    if (fill) fill.style.width = `${pct}%`;
  });

  const totalDone = document.querySelector<HTMLElement>('[data-total-done]');
  if (totalDone) totalDone.textContent = `${doneModules} / ${MODULES.length}`;

  // Filter jalur
  const cards = Array.from(document.querySelectorAll<HTMLElement>('[data-module-card]'));
  const pills = Array.from(document.querySelectorAll<HTMLButtonElement>('.filter-pill'));
  const counter = document.querySelector<HTMLElement>('[data-visible-count]');

  function applyFilter(key: string) {
    let shown = 0;
    cards.forEach((card) => {
      const visible = key === 'all' || card.dataset.track === key;
      card.hidden = !visible;
      if (visible) shown += 1;
    });
    pills.forEach((pill) => {
      const active = pill.dataset.filter === key;
      pill.classList.toggle('active', active);
      pill.setAttribute('aria-pressed', String(active));
    });
    if (counter) counter.textContent = `Menampilkan ${shown} modul`;
  }

  pills.forEach((pill) => pill.addEventListener('click', () => applyFilter(pill.dataset.filter ?? 'all')));
  applyFilter('all');
</script>

<style>
  .modules-hero {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1.5fr) minmax(260px, .7fr);
    gap: clamp(1.5rem, 4vw, 3rem);
    align-items: center;
    padding: clamp(2rem, 4.5vw, 3.5rem);
    border-radius: var(--radius-window);
    background: linear-gradient(140deg, rgba(255,255,255,.94), rgba(220,232,255,.80));
    border: 1px solid var(--glass-border);
    box-shadow: var(--glass-shadow);
    backdrop-filter: blur(20px); -webkit-backdrop-filter: blur(20px);
  }
  .hero-inner { color: var(--ink); }
  .hero-eyebrow {
    display: inline-flex; padding: .35rem .85rem; border-radius: var(--radius-pill);
    background: rgba(47,107,255,.12); color: var(--accent);
    font-size: var(--fs-micro); font-weight: 700; letter-spacing: .14em; text-transform: uppercase;
  }
  .hero-inner h1 { font-size: var(--fs-h1); margin: 1rem 0 1.1rem; text-wrap: balance; }
  .hero-inner h1 em { font-style: italic; color: var(--accent); }
  .hero-lead { font-size: var(--fs-body); line-height: 1.65; max-width: 60ch; color: var(--ink-soft); }
  .hero-actions { display: flex; flex-wrap: wrap; gap: .7rem; margin-top: 1.7rem; }
  .hero-actions .btn-ghost { background: #fff; border-color: var(--surface-border); color: var(--ink); }
  .hero-journey {
    display: grid; gap: 1rem; padding: 1.5rem; border-radius: var(--radius-card);
  }
  .journey-eyebrow { color: var(--ink-soft); }
  .journey-figure { display: flex; flex-direction: column; gap: .1rem; }
  .journey-figure strong { font-size: 3.1rem; line-height: 1; color: var(--accent); font-weight: 500; }
  .journey-figure span { font-size: var(--fs-small); color: var(--ink-soft); }
  .journey-track { list-style: none; display: grid; gap: .1rem; }
  .journey-track li {
    display: flex; align-items: baseline; gap: .7rem; padding: .55rem 0;
    border-bottom: 1px solid var(--surface-border);
    font-size: var(--fs-small); font-weight: 600; color: var(--ink);
  }
  .journey-track li:last-child { border-bottom: 0; }
  .journey-track li span { color: var(--accent); font-size: var(--fs-micro); font-weight: 700; }
  .journey-foot { font-size: var(--fs-micro); color: var(--ink-soft); }
  .journey-foot span { color: var(--ink); font-weight: 700; }

  @media (max-width: 900px) {
    .modules-hero { grid-template-columns: minmax(0, 1fr); }
  }

  .modules-section { margin-top: clamp(2.5rem, 5vw, 4rem); }
  .section-head { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 1rem;
    padding: 1.1rem 1.35rem; border-radius: var(--radius-card); }
  .section-head h2 { font-size: var(--fs-h2); margin-top: .4rem; }
  .section-head h2 em { font-style: italic; color: var(--accent); }
  .journey-summary { display: flex; align-items: baseline; gap: .6rem; border-radius: var(--radius-pill); padding: .65rem 1.1rem; }
  .summary-number { font-size: 1.15rem; font-weight: 700; color: var(--accent); }
  .summary-label { font-size: var(--fs-micro); color: var(--ink-soft); }

  .filter-bar { display: flex; flex-wrap: wrap; gap: .5rem; align-items: center;
    margin: 1rem 0 1.6rem; padding: .6rem .75rem; border-radius: var(--radius-pill); }
  .filter-pill {
    border: 1px solid var(--surface-border); background: #fff; color: var(--ink-soft);
    border-radius: var(--radius-pill); padding: .5rem 1rem; font-size: var(--fs-small); font-weight: 600;
    transition: background .15s ease, color .15s ease, transform .15s ease, box-shadow .15s ease;
  }
  .filter-pill:hover { transform: translateY(-1px); color: var(--ink); box-shadow: 0 6px 14px rgba(16,42,110,.12); }
  .filter-pill:focus-visible { outline: 3px solid var(--accent); outline-offset: 2px; }
  .filter-pill.active { background: var(--ink); color: #fff; border-color: var(--ink); }
  .filter-count { font-size: var(--fs-micro); margin-left: auto; color: var(--ink);
    background: var(--glass-bg-strong); border: 1px solid var(--glass-border);
    padding: .3rem .7rem; border-radius: var(--radius-pill); }
  .filter-count:empty { display: none; }

  /* Mode Mengajar: permukaan solid & kontras tinggi. */
  html[data-teaching='true'] .modules-hero { background: #fff; }
  html[data-teaching='true'] .hero-journey { background: #fff; border-color: var(--surface-border); }
  html[data-teaching='true'] .hero-inner { color: var(--ink); }
  html[data-teaching='true'] .hero-eyebrow { background: var(--accent-soft); color: var(--ink); }
  html[data-teaching='true'] .hero-lead { color: var(--ink); }

  .module-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--gap-bento); }
  .module-grid > :global([hidden]) { display: none; }
  @media (max-width: 1023px) { .module-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 639px) { .module-grid { grid-template-columns: 1fr; } }

  .cta-band {
    margin-top: 2rem; border-radius: var(--radius-window); padding: clamp(1.5rem, 4vw, 2.5rem);
    display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 1.5rem;
  }
  .cta-band h3 { font-size: var(--fs-h3); margin: .4rem 0; }
  .cta-band h3 em { font-style: italic; color: var(--ink); }
  .cta-band p { font-size: var(--fs-small); max-width: 60ch; }
  .cta-actions { display: flex; flex-wrap: wrap; gap: .6rem; }
</style>
