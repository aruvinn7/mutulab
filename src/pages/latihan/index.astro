---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PracticeRunner from '../../components/practice/PracticeRunner';
---

<BaseLayout
  title="Bank Latihan Soal Acak — MutuLab"
  description="Latihan soal DOE, Taguchi, dan acceptance sampling dengan seed yang dapat dibagikan, umpan balik per langkah, pembahasan, dan skor tiap sesi."
  wide
>
  <header class="page-intro pr-intro glass-solid">
    <p class="eyebrow">F-06 · Bank latihan soal acak</p>
    <h1 class="serif">Berlatih sampai rumusnya <em>melekat.</em></h1>
    <p class="lead">
      Soal dibangun dari template berparameter dengan <strong>seed</strong> yang deterministik: seed sama, soal dan kunci sama.
      Pilih modul dan tingkat kesulitan, kerjakan satu soal per layar, lalu buka umpan balik langkah demi langkah.
    </p>
    <div class="intro-chips">
      <span class="chip">17 template soal</span>
      <span class="chip">5 modul</span>
      <span class="chip">3 tingkat kesulitan</span>
      <span class="chip">Pembahasan tiap soal</span>
    </div>
  </header>

  <PracticeRunner client:load />
</BaseLayout>

<style is:global>
  /* Tipografi halaman latihan: Instrument Serif untuk h1, Manrope untuk UI/soal/angka. */
  .pr-intro .eyebrow,
  .pr-runner .eyebrow {
    font-family: var(--font-ui);
    font-size: var(--fs-micro);
    font-weight: 700;
    letter-spacing: .1em;
    text-transform: uppercase;
    color: var(--ink-soft);
  }
  .pr-field > .eyebrow { display: block; }

  .pr-intro { max-width: 820px; margin: 0 auto 2.4rem; text-align: center;
    padding: clamp(1.5rem, 4vw, 2.5rem); border-radius: var(--radius-window); }
  .pr-intro h1 { font-family: var(--font-display); font-weight: 400; font-size: var(--fs-h1); line-height: 1.12; margin: .3rem 0 .8rem; }
  .pr-intro h1 em { font-style: italic; }
  .pr-intro .lead { color: var(--ink-soft); font-family: var(--font-ui); font-size: var(--fs-body); line-height: 1.6; }
  .intro-chips { display: flex; flex-wrap: wrap; gap: .5rem; justify-content: center; margin-top: 1.2rem; }

  /* Satu pola untuk tombol & chip: pill, target sentuh ≥44px, hover/focus jelas. */
  .pr-intro .btn, .pr-runner .btn, .pr-intro .chip, .pr-runner .chip {
    font-family: var(--font-ui);
    min-height: 44px;
    border-radius: var(--radius-pill);
  }
  .pr-intro .btn, .pr-runner .btn { font-size: var(--fs-small); font-weight: 600; padding: .65rem 1.25rem; }
  .pr-intro .chip, .pr-runner .chip { font-size: var(--fs-small); font-weight: 600; letter-spacing: .02em; padding: .5rem 1rem; }
  .pr-runner .btn:hover { box-shadow: 0 6px 18px rgba(16, 42, 110, .18); }
  .pr-runner .btn:focus-visible, .pr-intro .btn:focus-visible { outline: 3px solid var(--accent); outline-offset: 2px; }
  .btn:disabled { opacity: .45; cursor: not-allowed; transform: none; box-shadow: none; }

  .pr-runner { display: grid; gap: 1.25rem; font-family: var(--font-ui); }
  .pr-controls { padding: 1.15rem 1.35rem; border-radius: var(--radius-card); }
  .pr-control-row { display: flex; flex-wrap: wrap; gap: 1rem; align-items: flex-end; }
  .pr-field { display: grid; gap: .35rem; flex: 1 1 220px; }
  .pr-field select {
    width: 100%; min-height: 44px; padding: .6rem .9rem; border-radius: var(--radius-pill); border: 1px solid var(--surface-border);
    background: var(--surface); color: var(--ink); font-family: var(--font-ui); font-size: var(--fs-small); font-weight: 500;
  }
  .pr-field select:focus-visible { outline: 3px solid var(--accent); outline-offset: 2px; }
  .pr-new { margin-left: auto; }
  .pr-share { display: flex; flex-wrap: wrap; align-items: center; gap: .6rem; margin-top: 1rem; padding-top: .9rem; border-top: 1px solid var(--surface-border); }
  .pr-copy { background: var(--surface); }
  .pr-share .pr-link { background: var(--surface); border-color: var(--surface-border); color: var(--accent); }
  .pr-share .chip { background: var(--accent-soft); border-color: transparent; color: var(--ink); }

  .pr-grid { align-items: start; }
  .pr-question { padding: 1.6rem 1.7rem 1.8rem; }
  .pr-question-head { display: flex; justify-content: space-between; align-items: flex-start; gap: 1rem; }
  /* Teks soal: Manrope, menonjol lewat ukuran --fs-h3, bukan keluarga font. */
  .pr-question h2 { font-family: var(--font-ui); font-size: var(--fs-h3); font-weight: 600;
    line-height: 1.6; letter-spacing: -.01em; overflow-wrap: break-word; margin: 1.1rem 0 1.3rem; }
  .pr-data { margin-bottom: 1.2rem; }
  .pr-data caption { caption-side: top; text-align: left; font-family: var(--font-ui); padding-bottom: .4rem; }
  .pr-data th { font-family: var(--font-ui); font-size: var(--fs-small); font-weight: 600; }
  .pr-data td { font-family: var(--font-mono); font-variant-numeric: tabular-nums; color: var(--ink); }
  .pr-formula { padding: .5rem 0 1.2rem; }
  .pr-formula .formula-block { background: var(--surface-soft); border-radius: 14px; padding: .8rem 1rem; overflow-x: auto; }
  .pr-answer-form { padding-top: 1rem; border-top: 1px solid var(--surface-border); }
  .pr-answer-form label { display: block; font-family: var(--font-ui); font-size: var(--fs-body); font-weight: 600; line-height: 1.5; margin-bottom: .5rem; }
  .pr-answer-form label span { font-size: var(--fs-small); font-weight: 400; }
  .pr-input-row { display: flex; flex-wrap: wrap; gap: .6rem; }
  .pr-input-row input {
    flex: 1 1 220px; min-width: 0; min-height: 44px; padding: .7rem 1rem; border-radius: var(--radius-pill);
    border: 1px solid var(--surface-border); background: var(--surface); font-family: var(--font-mono); font-variant-numeric: tabular-nums; font-size: var(--fs-body);
  }
  .pr-input-row input:focus { outline: 3px solid var(--accent); outline-offset: 2px; }
  .pr-input-row input:disabled { background: var(--surface-soft); opacity: .8; }
  .pr-notice { margin-top: .6rem; font-family: var(--font-ui); font-size: var(--fs-small); line-height: 1.5; color: #a5161b; }

  .pr-feedback { margin-top: 1.5rem; padding: 1.2rem; border-radius: var(--radius-card); background: var(--surface-soft); border: 1px solid var(--surface-border); }
  .pr-verdict { display: flex; flex-wrap: wrap; align-items: center; gap: .7rem; font-family: var(--font-ui); font-size: var(--fs-body); line-height: 1.5; margin-bottom: 1rem; }
  .pr-steps { list-style: none; display: grid; gap: .55rem; margin: .8rem 0 1rem; }
  .pr-step { display: flex; gap: .7rem; align-items: flex-start; padding: .7rem .85rem; border-radius: 14px; background: var(--surface); border: 1px solid var(--surface-border); font-family: var(--font-ui); font-size: var(--fs-body); line-height: 1.6; }
  .pr-step-no { font-family: var(--font-mono); font-variant-numeric: tabular-nums; font-weight: 700; color: var(--accent); flex-shrink: 0; }
  .pr-explanation { margin-top: 1.1rem; padding-top: 1rem; border-top: 1px solid var(--surface-border); }
  .pr-explanation p:not(.eyebrow) { font-family: var(--font-ui); font-size: var(--fs-body); line-height: 1.6; margin: .6rem 0 1rem; color: var(--ink); }

  .pr-side { display: grid; gap: 1rem; }
  .pr-side > section { padding: 1.25rem 1.35rem; }
  /* Angka skor memakai mono tabular, bukan serif. */
  .pr-score-big { font-family: var(--font-mono); font-variant-numeric: tabular-nums;
    font-size: calc(clamp(2.6rem, 5vw, 3.6rem) * var(--teach-scale)); line-height: 1; letter-spacing: -.04em; margin: .5rem 0; }
  .pr-score-big span { font-size: .5em; color: var(--ink-soft); letter-spacing: 0; }
  .pr-bar { height: 10px; border-radius: var(--radius-pill); background: var(--surface-border); overflow: hidden; margin-bottom: .6rem; }
  .pr-bar span { display: block; height: 100%; background: linear-gradient(90deg, var(--accent), var(--ok)); transition: width .3s ease; }
  .pr-score p:last-child { font-size: var(--fs-micro); }
  .pr-history-table { font-family: var(--font-ui); font-size: var(--fs-small); }
  .pr-history-table th, .pr-history-table td { font-family: var(--font-ui); }
  .pr-history-table .mono { font-family: var(--font-mono); font-variant-numeric: tabular-nums; }
  .pr-history-table th[scope='col'] { text-align: right; }
  .pr-history-table th[scope='col']:first-child { text-align: left; }
  .pr-history-note { font-size: var(--fs-micro); color: var(--ink-soft); margin-top: .8rem; line-height: 1.5; }
  .pr-tips ul { list-style: none; display: grid; gap: .55rem; margin-top: .7rem; }
  .pr-tips li { position: relative; padding-left: 1rem; font-size: var(--fs-body); line-height: 1.6; color: var(--ink); }
  .pr-tips li::before { content: '→'; position: absolute; left: 0; color: var(--accent); font-weight: 700; }

  @media (max-width: 639px) {
    .pr-new { margin-left: 0; width: 100%; }
    .pr-question { padding: 1.2rem; }
    .pr-share .btn { flex: 1 1 auto; }
    .pr-input-row input { flex-basis: 100%; }
  }
</style>
