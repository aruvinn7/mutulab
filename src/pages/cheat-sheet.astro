---
import BaseLayout from '../layouts/BaseLayout.astro';
import FormulaTabs from '../components/reference/FormulaTabs';
import DecisionTree from '../components/reference/DecisionTree';
import FTable from '../components/reference/FTable';
import OrthogonalArrays from '../components/reference/OrthogonalArrays';
---

<BaseLayout
  title="Cheat Sheet & Tabel Referensi — MutuLab"
  description="Ringkasan rumus per modul, panduan memilih desain eksperimen, tabel F yang dihitung dari calc-core, serta matriks orthogonal array L4, L8, dan L9."
  wide
>
  <header class="page-intro ref-intro glass-solid">
    <p class="eyebrow">F-10 · Referensi cepat</p>
    <h1 class="serif">Semua rumus, <em>satu halaman.</em></h1>
    <p class="lead">
      Pilih modul untuk melihat rumus kuncinya, ikuti pohon keputusan untuk memilih desain, lalu ambil nilai kritis F dan matriks orthogonal array yang dihitung dengan mesin yang sama seperti kalkulator.
    </p>
    <div class="intro-chips">
      <span class="chip">6 tab rumus</span>
      <span class="chip">Tabel F dinamis</span>
      <span class="chip">L4 · L8 · L9</span>
      <span class="chip">Decision tree interaktif</span>
    </div>
  </header>

  <h2 class="sr-only">Ringkasan rumus dan tabel referensi</h2>
  <div class="bento ref-grid">
    <div class="span-7"><FormulaTabs client:load /></div>
    <div class="span-5"><DecisionTree client:load /></div>
    <div class="span-12"><FTable client:load /></div>
    <div class="span-7"><OrthogonalArrays client:load /></div>
    <aside class="span-5 ref-notes card">
      <p class="eyebrow">Catatan pemakaian</p>
      <h2 class="serif">Sebelum membuka tabel</h2>
      <ul>
        <li><strong>Tabel F</strong> memakai df pembilang (perlakuan) sebagai df₁ dan df penyebut (galat) sebagai df₂. Nilainya dihitung ulang saat Anda mengganti α.</li>
        <li><strong>Orthogonal array</strong> menjaga keseimbangan level: setiap level muncul sama seringnya pada tiap kolom, sehingga efek dapat dipisahkan.</li>
        <li><strong>Decision tree</strong> hanya panduan awal. Kembali ke modul terkait untuk asumsi, validasi, dan contoh perhitungan lengkap.</li>
      </ul>
      <div class="ref-links">
        <a class="btn btn-primary" href="/modul/">Peta belajar</a>
        <a class="btn btn-ghost" href="/latihan/">Coba soal acak</a>
      </div>
    </aside>
  </div>
</BaseLayout>

<style is:global>
  .ref-intro { max-width: 820px; margin: 0 auto 2.4rem; text-align: center;
    padding: clamp(1.5rem, 4vw, 2.5rem); border-radius: var(--radius-window); }
  .ref-intro h1 { font-size: var(--fs-h1); margin: .3rem 0 .8rem; }
  .ref-intro .lead { color: var(--ink-soft); line-height: 1.7; }
  .intro-chips { display: flex; flex-wrap: wrap; gap: .5rem; justify-content: center; margin-top: 1.2rem; }
  .ref-grid { align-items: start; }

  /* Chip aktif dipakai bersama oleh semua komponen referensi. */
  .chip.is-active, .ft-tab.is-active {
    background: var(--ink); color: #fff; border-color: var(--ink);
  }

  /* --- FormulaTabs --- */
  .ft-tabs { display: grid; gap: 1rem; grid-template-columns: minmax(0, 1fr); min-width: 0; }
  .ft-tablist { display: flex; flex-wrap: wrap; gap: .45rem; width: fit-content; max-width: 100%; min-width: 0;
    padding: .45rem .5rem; border-radius: var(--radius-pill);
    background: var(--glass-bg-strong); border: 1px solid var(--glass-border); }
  .ft-tab { white-space: nowrap; }
  .ft-panel { padding: 1.4rem 1.5rem; }
  .ft-ringkas { font-size: var(--fs-small); margin-bottom: 1rem; }
  .ft-formulas { display: grid; gap: .85rem; }
  .ft-formula { padding: .85rem 1rem; border-radius: 14px; background: var(--surface-soft); border: 1px solid var(--surface-border); }
  .ft-formula .formula-block { overflow-x: auto; max-width: 100%; -webkit-overflow-scrolling: touch; }
  @media (max-width: 639px) {
    .ft-formula { padding: .7rem; }
    .ft-formula .formula-block { font-size: .85em; overflow-x: auto; }
    .ft-formula .katex-display { overflow-x: auto; overflow-y: hidden; padding-bottom: .2rem; }
    .ft-formula .katex { font-size: .78em; }
    .ft-formula p, .ft-formula li { overflow-wrap: anywhere; }
  }
  .ft-note { font-size: var(--fs-micro); margin-top: .35rem; line-height: 1.5; }

  /* --- DecisionTree --- */
  .dt-card { padding: 1.4rem 1.5rem; }
  .dt-head { display: flex; flex-wrap: wrap; gap: .8rem; align-items: flex-start; justify-content: space-between; }
  .dt-head h3, .oa-head h3, .f-table-head h3 { font-size: var(--fs-h3); margin-top: .25rem; }
  .dt-actions { display: flex; align-items: center; gap: .6rem; }
  .dt-actions .btn { padding: .45rem .85rem; }
  .btn:disabled { opacity: .45; cursor: not-allowed; transform: none; }
  .dt-trail { list-style: none; display: flex; flex-wrap: wrap; gap: .35rem; margin: 1rem 0; }
  .dt-trail li { font-size: var(--fs-micro); color: var(--ink-soft); background: var(--surface-soft); border-radius: var(--radius-pill); padding: .3rem .6rem; }
  .dt-trail li strong { color: var(--ink); }
  .dt-trail .dt-trail-empty { color: var(--accent); font-weight: 700; }
  .dt-question, .dt-result { padding: 1.1rem; border-radius: var(--radius-card); background: #fff; border: 1px solid var(--surface-border); }
  .dt-step { font-size: var(--fs-micro); letter-spacing: .1em; text-transform: uppercase; color: var(--accent); font-weight: 700; }
  .dt-question h4, .dt-result h4 { font-size: calc(var(--fs-h3) * 1.05); margin: .4rem 0 .5rem; }
  .dt-question p:not(.dt-step) { font-size: var(--fs-small); color: var(--ink-soft); }
  .dt-options { display: grid; gap: .55rem; margin-top: 1rem; }
  .dt-option { display: flex; justify-content: space-between; align-items: center; gap: .8rem; text-align: left;
    padding: .8rem 1rem; border-radius: 14px; border: 1px solid var(--surface-border); background: var(--surface-soft);
    font-size: var(--fs-small); font-weight: 600; transition: border-color .15s ease, transform .15s ease; }
  .dt-option:hover { border-color: var(--accent); transform: translateX(2px); }
  .dt-option span { color: var(--accent); }
  .dt-result p { font-size: var(--fs-small); color: var(--ink-soft); line-height: 1.65; margin: .5rem 0 1rem; }
  .dt-links { display: flex; flex-wrap: wrap; gap: .6rem; }

  /* --- FTable --- */
  .f-table { padding: 1.4rem 1.5rem; }
  .f-table-head { display: flex; flex-wrap: wrap; gap: 1rem; justify-content: space-between; align-items: center; margin-bottom: 1rem; }
  .f-alpha { display: flex; flex-wrap: wrap; gap: .4rem; }
  .f-grid { font-size: var(--fs-micro); }
  .f-grid caption { caption-side: top; text-align: left; font-family: var(--font-ui); line-height: 1.5; color: var(--ink-soft); padding-bottom: .7rem; }
  .f-grid th { text-align: center; }
  .f-grid th[scope='col']:first-child, .f-grid th[scope='row'] { text-align: left; }
  .f-grid th[scope='row'] { font-family: var(--font-mono); background: var(--surface-soft); }
  .f-source { font-size: var(--fs-micro); margin-top: .9rem; line-height: 1.6; }

  /* --- OrthogonalArrays --- */
  .oa-card { padding: 1.4rem 1.5rem; }
  .oa-head { display: flex; flex-wrap: wrap; gap: 1rem; justify-content: space-between; align-items: center; margin-bottom: 1rem; }
  .oa-tabs { display: flex; flex-wrap: wrap; gap: .4rem; }
  .oa-grid caption { caption-side: top; text-align: left; font-family: var(--font-ui); color: var(--ink-soft); padding-bottom: .6rem; }
  .oa-grid th[scope='row'] { background: var(--surface-soft); text-align: left; }
  .oa-note { font-size: var(--fs-small); line-height: 1.6; margin-top: .9rem; }

  .ref-notes { padding: 1.5rem; }
  .ref-notes h2 { font-size: var(--fs-h3); margin: .3rem 0 .9rem; }
  .ref-notes ul { list-style: none; display: grid; gap: .8rem; }
  .ref-notes li { padding-left: 1rem; position: relative; font-size: var(--fs-small); line-height: 1.6; color: var(--ink-soft); }
  .ref-notes li::before { content: '◇'; position: absolute; left: 0; color: var(--accent); }
  .ref-links { display: flex; flex-wrap: wrap; gap: .6rem; margin-top: 1.3rem; }
</style>
